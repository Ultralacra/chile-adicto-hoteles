    {
      "name": "03 - Comparar Host A: Site A vs Site B",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{hostA}}/api/posts?categorySlug={{categorySlug}}&previewSite={{siteB}}",
          "host": ["{{hostA}}"],
          "path": ["api", "posts"],
          "query": [
            {
