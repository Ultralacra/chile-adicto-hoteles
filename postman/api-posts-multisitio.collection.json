            {
              "key": "previewSite",
              "value": "{{siteB}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const shapeA = pm.collectionVariables.get('shape_list_hostA_siteA') || '';",
              "const shapeB = pm.collectionVariables.get('shape_list_hostA_siteB') || '';",
              "",
              "pm.test('Se guardaron shapes previos', function () {",
              "  pm.expect(shapeA.length).to.be.above(0);",
              "  pm.expect(shapeB.length).to.be.above(0);",
              "});",
              "",
              "pm.test('Shape igual entre sitios en Host A', function () {",
              "  pm.expect(shapeB).to.eql(shapeA);",
              "});"
            ]
          }
        }
      ]
