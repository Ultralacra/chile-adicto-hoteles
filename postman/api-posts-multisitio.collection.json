{
  "info": {
    "name": "API Posts Multihost + Multisitio - Chile Adicto Hoteles",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección para validar consistencia de respuesta en /api/posts entre distintos hosts y sitios (shape debería ser igual)."
  },
  "variable": [
    {
      "key": "hostA",
      "value": "https://chile-adicto-hoteles-front.vercel.app"
    },
    {
      "key": "hostB",
      "value": "https://chile-adicto-hoteles.vercel.app"
    },
    {
      "key": "siteA",
      "value": "santiagoadicto"
    },
    {
      "key": "siteB",
      "value": "chileadicto"
    },
    {
      "key": "categorySlug",
      "value": "prensa"
    },
    {
      "key": "slugSiteA",
      "value": "santiagoadicto-en-radio-duna-cuarta-parte-de-los-mejores-hoteles-destino-de-chile"
    },
    {
      "key": "slugSiteB",
      "value": "santiagoadicto-en-radio-duna-cuarta-parte-de-los-mejores-hoteles-destino-de-chile"
    }
  ],
  "item": [
    {
      "name": "01 - Host A / Site A - Lista posts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{hostA}}/api/posts?categorySlug={{categorySlug}}&previewSite={{siteA}}",
          "host": ["{{hostA}}"],
          "path": ["api", "posts"],
          "query": [
            {
              "key": "categorySlug",
              "value": "{{categorySlug}}"
            },
            {
              "key": "previewSite",
              "value": "{{siteA}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const data = pm.response.json();",
              "pm.test('Respuesta es array', function () {",
              "  pm.expect(Array.isArray(data)).to.eql(true);",
              "});",
              "",
              "if (Array.isArray(data) && data.length > 0) {",
              "  const obj = data[0];",
              "  const required = [",
              "    'slug', 'site', 'publicationStatus', 'publishStartAt', 'publishEndAt', 'publicationEndsAt',",
              "    'featuredImage', 'website', 'websitePublic', 'websitepublic', 'website_public',",
              "    'instagram', 'website_display', 'instagram_display', 'email', 'phone', 'photosCredit',",
              "    'address', 'hours', 'reservationLink', 'reservationPolicy', 'interestingFact',",
              "    'images', 'locations', 'es', 'en', 'categories', 'communes'",
              "  ];",
              "",
              "  pm.test('Tiene propiedades base completas', function () {",
              "    required.forEach((k) => pm.expect(obj).to.have.property(k));",
              "  });",
              "",
              "  pm.collectionVariables.set('shape_list_hostA_siteA', Object.keys(obj).sort().join(','));",
              "}"
            ]
          }
        }
      ]
    },
